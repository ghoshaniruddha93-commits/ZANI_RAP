projection;
strict ( 2 );
use draft;
use side effects;
define behavior for ZATS_AG_TRAVEL_PROCESSOR alias Travel
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Resume;
  use action Activate;
  use action Discard;
  use action Prepare;
//
use association _Booking { create; with draft; }

  use action CopyTravel;
}

define behavior for ZATS_AG_BOOKING_PROCESSOR alias Booking
{
  use update;
  use delete;

  use association _Travel { with draft; }
  use association _BookingSupplement { create; with draft; }
}

define behavior for ZATS_AG_BOOKINGSUPPL_PROCESSOR alias BookSuppl
{
  use update;
  use delete;

  use association _Travel { with draft; }
  use association _Booking { with draft; }
}