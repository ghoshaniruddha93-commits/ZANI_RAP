@Metadata.layer: #CUSTOMER
@UI.headerInfo: {
    typeName: 'Travel',
    typeNamePlural: 'Travels',
    title: { value: 'TravelId' },
    description: { value: '_Customer.FirstName' }
    }
annotate entity ZATS_AG_TRAVEL_PROCESSOR with
{
  @UI.facet: [{ purpose: #HEADER,
                type: #DATAPOINT_REFERENCE,
                position: 10,
                label: 'Flight Ticket Price',
                targetQualifier: 'Price_data'
              },
              { purpose: #HEADER,
                type:#DATAPOINT_REFERENCE,
                position: 20,
                label: 'Travel Status',
                targetQualifier: 'Status'
              },
              {
                purpose: #STANDARD,
                type: #COLLECTION,
                position: 10,
                label: 'Additional Info',
                id: 'Super'
              },
              {
                purpose: #STANDARD,
                type: #IDENTIFICATION_REFERENCE,
                position: 10,
                label: 'More Info',
                parentId: 'Super'
              },
              {
                purpose: #STANDARD,
                type: #FIELDGROUP_REFERENCE,
                position: 20,
                label: 'Price data',
                parentId: 'Super',
                targetQualifier: 'Price'
               },
               {
                purpose: #STANDARD,
                type: #FIELDGROUP_REFERENCE,
                position: 30,
                label: 'Travel Dates',
                parentId: 'Super',
                targetQualifier: 'Dates'
               },
               {
                purpose: #STANDARD,
                type: #FIELDGROUP_REFERENCE,
                position: 40,
                label: 'Admin Info',
                parentId: 'Super',
                targetQualifier: 'Admin'
               },
               {
                purpose: #STANDARD,
                type: #LINEITEM_REFERENCE,
                position: 20,
                label: 'Bookings',
                targetElement: '_Booking'
               }
             ]
  @UI.selectionField: [{ position: 10 }]
  @UI.lineItem: [{ position: 10 },
  { type: #FOR_ACTION, label: 'Copy Travel ',
  dataAction: 'CopyTravel'}]
  @UI.identification: [{ position: 10 },
  { type: #FOR_ACTION, label: 'Copy Travel ',
  dataAction: 'CopyTravel'}]
  TravelId;
  @UI.selectionField: [{ position: 20 }]
  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20  }]
  AgencyId;
  @UI.selectionField: [{ position: 30 }]
  @UI.lineItem:[{ position: 30 }]
  @UI.identification: [{ position: 30  }]
  CustomerId;
  @UI.fieldGroup: [{ qualifier: 'Dates', position: 10 }]
  BeginDate;
  @UI.fieldGroup: [{ qualifier: 'Dates', position: 20 }]
  EndDate;
  @UI.fieldGroup: [{ qualifier: 'Price', position: 10 }]
  BookingFee;
  @UI.selectionField: [{ position: 40 }]
  @UI.lineItem: [{ position: 50 }]
  @UI.dataPoint: { qualifier: 'Price_data' , title: 'Flight Price' }
  @UI.fieldGroup: [{ qualifier: 'Price', position: 20 }]
  TotalPrice;
  @UI.fieldGroup: [{ qualifier: 'Price', position: 30 }]
  CurrencyCode;
  @UI.lineItem:[{ position: 60 }]
  Description;
  @UI.selectionField: [{ position: 50 }]
  @UI.lineItem:[{ position: 70 , criticality: 'Criticality' , importance: #HIGH }]
  @UI.dataPoint: { qualifier: 'Status', title: 'Travel Status', criticality: 'Criticality' }
  @UI.fieldGroup: [{ qualifier: 'Dates', position: 30, label: 'Status', criticality: 'Criticality' }]
  OverallStatus;
  @UI.fieldGroup: [{ qualifier: 'Admin', position: 10 }]
  CreatedBy;
  @UI.fieldGroup: [{ qualifier: 'Admin', position: 20 }]
  CreatedAt;
  @UI.fieldGroup: [{ qualifier: 'Admin', position: 30 }]
  LastChangedBy;
  @UI.fieldGroup: [{ qualifier: 'Admin', position: 40 }]
  LastChangedAt;
}